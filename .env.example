# mcp-postgres-sheets configuration. Copy to `.env` (git-ignored) and fill in.
# Every variable is also documented at site/ → Configuration.

# ---------------------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------------------
# Connection string for the READ-ONLY role (create it with deploy/sql/001_readonly_role.sql).
# The sample database from `docker compose up -d db` listens on localhost:5544.
DATABASE_URL=postgresql://mcp_readonly:mcp_readonly@localhost:5544/shop
# Comma-separated schemas the AI may see and query.
ALLOWED_SCHEMAS=public
# Optional comma-separated table allow-list (`orders` or `public.orders`). Empty = all tables in ALLOWED_SCHEMAS.
ALLOWED_TABLES=
# Per-query statement timeout in milliseconds.
QUERY_TIMEOUT_MS=5000
# Maximum rows returned by one postgres_query call (results are truncated, and say so).
MAX_ROWS=500

# ---------------------------------------------------------------------------------------
# Google Sheets
# ---------------------------------------------------------------------------------------
# `google` (real API via a service account) or `memory` (built-in demo spreadsheet, no Google account needed).
SHEETS_BACKEND=google
# Path to the service-account key file, or the key JSON itself (e.g. injected from a secret store).
# Create one: https://console.cloud.google.com/iam-admin/serviceaccounts → Keys → Add key → JSON.
# Enable the Sheets API: https://console.cloud.google.com/apis/library/sheets.googleapis.com
# Then share your spreadsheet with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# Comma-separated spreadsheet IDs the AI may touch (the long ID in the sheet's URL). Empty = no sheets.
ALLOWED_SHEET_IDS=
# Only for SHEETS_BACKEND=memory: JSON file with demo spreadsheets (defaults to the bundled sample).
SHEETS_MEMORY_FILE=

# ---------------------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------------------
# true = write tools (sheets_append_rows, sheets_update_range) are not registered at all.
READ_ONLY=true

# ---------------------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------------------
# `stdio` (local AI clients) or `http` (remote, Streamable HTTP + OAuth bearer tokens).
TRANSPORT=stdio
# HTTP mode only. Use 0.0.0.0 inside a container.
HTTP_HOST=127.0.0.1
# HTTP mode only: port to listen on.
HTTP_PORT=8765
# HTTP mode only: the public base URL clients use (OAuth resource identifier), e.g. https://mcp.example.com
PUBLIC_URL=http://localhost:8765
# HTTP mode only: extra Host header values to accept, comma-separated (DNS-rebinding protection).
HTTP_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------------------
# OAuth 2.1 resource server (HTTP mode only — required there)
# ---------------------------------------------------------------------------------------
# Issuer of the access tokens (any OIDC provider: Entra ID, Auth0, Keycloak…).
# Local Keycloak test profile: http://localhost:8180/realms/mcp
OAUTH_ISSUER=
# Expected `aud` claim, e.g. the API's application ID URI (Entra ID) or `mcp-postgres-sheets` (Keycloak profile).
OAUTH_AUDIENCE=
# Optional JWKS URL override (defaults to the issuer's OIDC discovery document).
OAUTH_JWKS_URL=
# Tool calls allowed per caller (token subject) per minute.
RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------------------------
# Audit log and observability
# ---------------------------------------------------------------------------------------
# File for the JSON-lines audit log. Empty = stderr (stdio mode) or stdout (http mode).
AUDIT_LOG_PATH=
# true = argument values are replaced by a hash + length in the audit log (identifiers like table names are kept).
REDACT_ARGS=true
# Server log level (DEBUG, INFO, WARNING, ERROR). Logs never contain secrets or row data.
LOG_LEVEL=INFO
# Optional Sentry DSN for error tracking (install with the `sentry` extra). Empty = off.
# https://sentry.io → Project settings → Client keys (DSN)
SENTRY_DSN=

# ---------------------------------------------------------------------------------------
# Evaluation only (make eval) — never used by the server
# ---------------------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey  (free-tier data may be used by Google: synthetic data only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
