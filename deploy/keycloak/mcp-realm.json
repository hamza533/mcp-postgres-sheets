{
  "realm": "mcp",
  "displayName": "mcp-postgres-sheets (LOCAL TESTING ONLY)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {"access.token.claim": "true", "introspection.token.claim": "true"}
        }
      ]
    },
    {
      "name": "mcp-audience",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "audience: mcp-postgres-sheets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-postgres-sheets",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "db:read",
      "description": "Read the PostgreSQL database through mcp-postgres-sheets",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Query your database (read-only)"}
    },
    {
      "name": "sheets:read",
      "description": "Read allow-listed Google Sheets",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Read your spreadsheets"}
    },
    {
      "name": "sheets:write",
      "description": "Append to and update allow-listed Google Sheets",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Change your spreadsheets"}
    }
  ],
  "clients": [
    {
      "clientId": "mcp-reader",
      "name": "Test client: read-only (db:read, sheets:read)",
      "enabled": true,
      "publicClient": false,
      "secret": "reader-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "mcp-audience", "db:read", "sheets:read"],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-writer",
      "name": "Test client: read + sheets:write",
      "enabled": true,
      "publicClient": false,
      "secret": "writer-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "mcp-audience", "db:read", "sheets:read", "sheets:write"],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-db-only",
      "name": "Test client: db:read only",
      "enabled": true,
      "publicClient": false,
      "secret": "db-only-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "mcp-audience", "db:read"],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-inspector",
      "name": "Interactive login for the MCP Inspector (authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:6274/*", "http://127.0.0.1:6274/*"],
      "webOrigins": ["+"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+"},
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "mcp-audience", "db:read", "sheets:read"],
      "optionalClientScopes": ["sheets:write"]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [{"type": "password", "value": "demo", "temporary": false}]
    }
  ]
}
